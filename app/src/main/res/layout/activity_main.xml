<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/verde"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="8dp"
        android:paddingStart="4dp"
        android:paddingEnd="16dp">

        <ImageButton
            android:id="@+id/btnVolver"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Volver a Infomaxis"
            android:src="@drawable/ic_volver" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="INFOMAXIS"
                android:textColor="@color/amarillo"
                android:letterSpacing="0.12"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Inventario equipos"
                android:textColor="@color/blanco"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@color/amarillo"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:text="0 cajas"
            android:textColor="@color/tinta"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- ================= TIENDA ================= -->
            <TextView style="@style/Seccion" android:text="Tienda" />

            <com.google.android.material.card.MaterialCardView style="@style/Tarjeta">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView style="@style/Etiqueta" android:text="CLIENTE" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipsCliente"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:chipSpacingVertical="0dp"
                        app:singleSelection="true" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/boxClienteOtro"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:hint="Escribe el nombre del cliente"
                        android:visibility="gone">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtClienteOtro"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textCapWords" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <LinearLayout
                        android:id="@+id/grupoTienda"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView style="@style/Etiqueta" android:layout_marginTop="14dp" android:text="N° DE TIENDA" />

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Ej: 512">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/edtTienda"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="monospace"
                                android:inputType="textCapCharacters|textNoSuggestions" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <TextView style="@style/Etiqueta" android:layout_marginTop="14dp" android:text="DIRECCIÓN DE LA TIENDA" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Calle, número y comuna">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtDireccion"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPostalAddress|textCapWords" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView style="@style/Etiqueta" android:layout_marginTop="14dp" android:text="REGIÓN" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Elige la región">

                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/edtRegion"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="none" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView style="@style/Etiqueta" android:layout_marginTop="14dp" android:text="FECHA" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/boxFecha"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:helperText="Toca para cambiar la fecha"
                        app:endIconMode="custom"
                        app:endIconDrawable="@drawable/ic_calendar"
                        app:endIconContentDescription="Cambiar fecha">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtFecha"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:cursorVisible="false"
                            android:focusable="false"
                            android:fontFamily="monospace"
                            android:inputType="none" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ================= CAJA ================= -->
            <TextView android:id="@+id/txtSeccionCaja" style="@style/Seccion" android:layout_marginTop="22dp" android:text="Caja" />

            <com.google.android.material.card.MaterialCardView style="@style/Tarjeta">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView style="@style/Etiqueta" android:text="TIPO DE CAJA" />

                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/grupoTipo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:selectionRequired="false"
                        app:singleSelection="true">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnPos"
                            style="@style/BotonTipo"
                            android:text="POS" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSsco"
                            style="@style/BotonTipo"
                            android:text="SSCO" />
                    </com.google.android.material.button.MaterialButtonToggleGroup>

                    <TextView style="@style/Etiqueta" android:layout_marginTop="14dp" android:text="UBICACIÓN POS" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Ej: Caja 3, caja rápida">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtUbicacion"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textCapSentences" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView style="@style/Etiqueta" android:layout_marginTop="14dp" android:text="N° DE POS" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Ej: 05">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtNumeroPos"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:inputType="textCapCharacters|textNoSuggestions" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:id="@+id/txtElegirTipo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/fondo_componente"
                        android:gravity="center"
                        android:padding="16dp"
                        android:text="Elige POS o SSCO para ver sus componentes."
                        android:textColor="@color/gris" />

                    <TextView
                        android:id="@+id/txtComponentes"
                        style="@style/Etiqueta"
                        android:layout_marginTop="16dp"
                        android:text="COMPONENTES · deja vacío lo que no tenga"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/contenedorPiezas"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <TextView style="@style/Etiqueta" android:layout_marginTop="14dp" android:text="NOTAS" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Opcional">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtNotas"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textCapSentences" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGuardar"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:layout_marginTop="18dp"
                        android:text="GUARDAR CAJA"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        app:cornerRadius="8dp" />

                    <LinearLayout
                        android:id="@+id/barEdicion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCancelar"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Cancelar edición" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnBorrar"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Borrar fila"
                            android:textColor="@color/rojo" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ================= PLANILLA ================= -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Seccion"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginBottom="0dp"
                    android:text="Planilla" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Toca una fila para editarla"
                    android:textColor="@color/gris"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnNuevo"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="Nuevo Excel"
                    android:textColor="@color/tinta"
                    app:cornerRadius="8dp"
                    app:strokeColor="@color/linea" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCargar"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:text="Cargar Excel"
                    android:textColor="@color/tinta"
                    app:cornerRadius="8dp"
                    app:strokeColor="@color/linea" />
            </LinearLayout>

            <TextView
                android:id="@+id/txtVacio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/blanco"
                android:gravity="center"
                android:padding="24dp"
                android:text="Todavía no hay cajas.\nCompleta los datos de la tienda, elige POS o SSCO, fotografía las series de cada componente y toca «Guardar caja».\n\n¿Ya tenías un Excel empezado? Toca «Cargar Excel»."
                android:textColor="@color/gris" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/lista"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/blanco"
        android:elevation="8dp"
        android:orientation="horizontal"
        android:padding="12dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExportar"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:backgroundTint="@color/amarillo"
            android:text="EXPORTAR EXCEL"
            android:textColor="@color/tinta"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="8dp" />
    </LinearLayout>
</LinearLayout>
