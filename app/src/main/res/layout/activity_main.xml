<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/verde"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="14dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Escáner de Inventario"
            android:textColor="@color/blanco"
            android:textSize="21sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@color/amarillo"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:text="0 filas"
            android:textColor="@color/tinta"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- ================= TIENDA ================= -->
            <TextView style="@style/Seccion" android:text="Tienda" />

            <com.google.android.material.card.MaterialCardView style="@style/Tarjeta">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView style="@style/Etiqueta" android:text="CLIENTE" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipsCliente"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:chipSpacingVertical="0dp"
                        app:singleSelection="true" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/boxClienteOtro"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:hint="Escribe el nombre del cliente"
                        android:visibility="gone">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtClienteOtro"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textCapWords" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <LinearLayout
                        android:id="@+id/grupoTienda"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView style="@style/Etiqueta" android:layout_marginTop="14dp" android:text="N° DE TIENDA" />

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Ej: 512">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/edtTienda"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="monospace"
                                android:inputType="textCapCharacters|textNoSuggestions" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <TextView style="@style/Etiqueta" android:layout_marginTop="14dp" android:text="DIRECCIÓN DE LA TIENDA" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Calle, número y comuna">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtDireccion"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPostalAddress|textCapWords" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView style="@style/Etiqueta" android:layout_marginTop="14dp" android:text="REGIÓN" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Elige la región">

                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/edtRegion"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="none" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView style="@style/Etiqueta" android:layout_marginTop="14dp" android:text="FECHA" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/boxFecha"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:helperText="Toca para cambiar la fecha"
                        app:endIconMode="custom"
                        app:endIconDrawable="@drawable/ic_calendar"
                        app:endIconContentDescription="Cambiar fecha">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtFecha"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:cursorVisible="false"
                            android:focusable="false"
                            android:fontFamily="monospace"
                            android:inputType="none" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ================= EQUIPO ================= -->
            <TextView style="@style/Seccion" android:layout_marginTop="22dp" android:text="Equipo" />

            <com.google.android.material.card.MaterialCardView style="@style/Tarjeta">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView style="@style/Etiqueta" android:text="TIPO DE EQUIPO" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipsTipo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:chipSpacingVertical="0dp"
                        app:singleSelection="true" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:hint="O escribe otro tipo">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtTipo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textCapSentences" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView style="@style/Etiqueta" android:layout_marginTop="14dp" android:text="MODELO" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="Foto a la etiqueta o escribir">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/edtModelo"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="monospace"
                                android:inputType="textNoSuggestions|textCapCharacters" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnFotoModelo"
                            style="@style/BotonCamara"
                            android:contentDescription="Fotografiar modelo" />
                    </LinearLayout>

                    <TextView android:id="@+id/stModelo" style="@style/Estado" />

                    <TextView style="@style/Etiqueta" android:layout_marginTop="10dp" android:text="N° DE SERIE" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="Foto al código o S/N">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/edtSerie"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="monospace"
                                android:inputType="textNoSuggestions|textCapCharacters" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnFotoSerie"
                            style="@style/BotonCamara"
                            android:contentDescription="Fotografiar número de serie" />
                    </LinearLayout>

                    <TextView android:id="@+id/stSerie" style="@style/Estado" />

                    <TextView style="@style/Etiqueta" android:layout_marginTop="10dp" android:text="UBICACIÓN POS" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Ej: POS 3, caja rápida">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtUbicacion"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textCapSentences" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView style="@style/Etiqueta" android:layout_marginTop="14dp" android:text="NOTAS" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Opcional">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtNotas"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textCapSentences" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGuardar"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:layout_marginTop="18dp"
                        android:text="GUARDAR FILA"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        app:cornerRadius="8dp" />

                    <LinearLayout
                        android:id="@+id/barEdicion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCancelar"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Cancelar edición" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnBorrar"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Borrar fila"
                            android:textColor="@color/rojo" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ================= PLANILLA ================= -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Seccion"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginBottom="0dp"
                    android:text="Planilla" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Toca una fila para editarla"
                    android:textColor="@color/gris"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnNuevo"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="Nuevo Excel"
                    android:textColor="@color/tinta"
                    app:cornerRadius="8dp"
                    app:strokeColor="@color/linea" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCargar"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:text="Cargar Excel"
                    android:textColor="@color/tinta"
                    app:cornerRadius="8dp"
                    app:strokeColor="@color/linea" />
            </LinearLayout>

            <TextView
                android:id="@+id/txtVacio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/blanco"
                android:gravity="center"
                android:padding="24dp"
                android:text="Todavía no hay equipos.\nCompleta los datos de la tienda, saca la foto del modelo y de la serie, y toca «Guardar fila».\n\n¿Ya tenías un Excel empezado? Toca «Cargar Excel»."
                android:textColor="@color/gris" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/lista"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/blanco"
        android:elevation="8dp"
        android:orientation="horizontal"
        android:padding="12dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExportar"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:backgroundTint="@color/amarillo"
            android:text="EXPORTAR EXCEL"
            android:textColor="@color/tinta"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="8dp" />
    </LinearLayout>
</LinearLayout>
